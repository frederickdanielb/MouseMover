<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>MouseMover</AssemblyName>
    <RootNamespace>MouseMover</RootNamespace>
    <Version>1.0.0</Version>
    <Title>MouseMover</Title>
    <Description>Local Windows desktop utility for brief cursor-movement tests.</Description>
    <Authors>MouseMover contributors</Authors>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
