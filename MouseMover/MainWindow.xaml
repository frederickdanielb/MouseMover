<Window x:Class="MouseMover.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MouseMover" Width="600" MinWidth="600" SizeToContent="Height" ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI" /></Style>
    </Window.Resources>
    <Grid Background="#F6F8FB">
        <Border Margin="28" Padding="28" Background="White" CornerRadius="12" BorderBrush="#D9E0EA" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="MouseMover" FontSize="25" FontWeight="SemiBold" Foreground="#162234" />
                    <TextBlock Margin="0,6,0,0" Text="Herramienta local para probar el movimiento breve del cursor." Foreground="#536174" />
                </StackPanel>
                <Grid Grid.Row="1" Margin="0,27,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Intervalo" />
                    <ComboBox x:Name="IntervalComboBox" Grid.Column="1" Margin="16,0,0,0" SelectedIndex="1" SelectionChanged="IntervalComboBox_SelectionChanged">
                        <ComboBoxItem Tag="15">15 segundos</ComboBoxItem><ComboBoxItem Tag="30">30 segundos</ComboBoxItem>
                        <ComboBoxItem Tag="60">1 minuto</ComboBoxItem><ComboBoxItem Tag="300">5 minutos</ComboBoxItem>
                    </ComboBox>
                    <TextBlock x:Name="MovementDescriptionTextBlock" Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#69788B" />
                </Grid>
                <Grid Grid.Row="2" Margin="0,26,0,0">
                    <Border Padding="20" Background="#EEF4FB" CornerRadius="8">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="StatusTextBlock" FontSize="18" FontWeight="SemiBold" Foreground="#23466C" Text="Estado: detenido" />
                            <TextBlock x:Name="NextMoveTextBlock" Grid.Row="1" Margin="0,10,0,0" Foreground="#3E5873" Text="Próximo movimiento: --" />
                            <TextBlock x:Name="MoveCountTextBlock" Grid.Row="2" Margin="0,6,0,0" Foreground="#3E5873" Text="Movimientos realizados: 0" />
                            <TextBlock x:Name="IdleTimeTextBlock" Grid.Row="3" Margin="0,6,0,0" Foreground="#3E5873" TextWrapping="Wrap" />
                            <TextBlock x:Name="MovementResultTextBlock" Grid.Row="4" Margin="0,6,0,0" Foreground="#3E5873" TextWrapping="Wrap" Text="Último intento: pendiente." />
                        </Grid>
                    </Border>

                    <Canvas x:Name="MousePeekTopLeft" Width="48" Height="42" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-14,-18,0,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><ScaleTransform x:Name="MousePeekTopLeftScale" ScaleX="0.6" ScaleY="0.6" /></Canvas.RenderTransform>
                        <Ellipse Canvas.Left="3" Canvas.Top="0" Width="16" Height="16" Fill="#5B5650" />
                        <Ellipse Canvas.Left="33" Canvas.Top="0" Width="16" Height="16" Fill="#5B5650" />
                        <Ellipse Canvas.Left="7" Canvas.Top="3" Width="8" Height="8" Fill="#3A2E2C" />
                        <Ellipse Canvas.Left="37" Canvas.Top="3" Width="8" Height="8" Fill="#3A2E2C" />
                        <Ellipse Canvas.Left="6" Canvas.Top="11" Width="40" Height="33" Fill="#6C6459" />
                        <Polygon Points="13,20 24,23 13,24" Fill="#1B1512" />
                        <Polygon Points="39,20 28,23 39,24" Fill="#1B1512" />
                        <Polygon Points="14,24 23,25 14,27" Fill="#C4342B" />
                        <Polygon Points="38,24 29,25 38,27" Fill="#C4342B" />
                        <Ellipse Canvas.Left="23" Canvas.Top="27" Width="6" Height="5" Fill="#241F1B" />
                        <Path Data="M 16,34 Q 26,40 36,34" Stroke="#1B1512" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Polygon Points="19,35 21,35 20,39" Fill="#F4F1EC" />
                        <Polygon Points="31,35 33,35 32,39" Fill="#F4F1EC" />
                    </Canvas>

                    <Canvas x:Name="MousePeekTopRight" Width="48" Height="42" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-18,-14,0" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><ScaleTransform x:Name="MousePeekTopRightScale" ScaleX="0.6" ScaleY="0.6" /></Canvas.RenderTransform>
                        <Ellipse Canvas.Left="3" Canvas.Top="0" Width="16" Height="16" Fill="#5B5650" />
                        <Ellipse Canvas.Left="33" Canvas.Top="0" Width="16" Height="16" Fill="#5B5650" />
                        <Ellipse Canvas.Left="7" Canvas.Top="3" Width="8" Height="8" Fill="#3A2E2C" />
                        <Ellipse Canvas.Left="37" Canvas.Top="3" Width="8" Height="8" Fill="#3A2E2C" />
                        <Ellipse Canvas.Left="6" Canvas.Top="11" Width="40" Height="33" Fill="#6C6459" />
                        <Polygon Points="13,20 24,23 13,24" Fill="#1B1512" />
                        <Polygon Points="39,20 28,23 39,24" Fill="#1B1512" />
                        <Polygon Points="14,24 23,25 14,27" Fill="#C4342B" />
                        <Polygon Points="38,24 29,25 38,27" Fill="#C4342B" />
                        <Ellipse Canvas.Left="23" Canvas.Top="27" Width="6" Height="5" Fill="#241F1B" />
                        <Path Data="M 16,34 Q 26,40 36,34" Stroke="#1B1512" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Polygon Points="19,35 21,35 20,39" Fill="#F4F1EC" />
                        <Polygon Points="31,35 33,35 32,39" Fill="#F4F1EC" />
                    </Canvas>

                    <Canvas x:Name="MousePeekBottomLeft" Width="48" Height="42" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-14,0,0,-18" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><ScaleTransform x:Name="MousePeekBottomLeftScale" ScaleX="0.6" ScaleY="0.6" /></Canvas.RenderTransform>
                        <Ellipse Canvas.Left="3" Canvas.Top="0" Width="16" Height="16" Fill="#5B5650" />
                        <Ellipse Canvas.Left="33" Canvas.Top="0" Width="16" Height="16" Fill="#5B5650" />
                        <Ellipse Canvas.Left="7" Canvas.Top="3" Width="8" Height="8" Fill="#3A2E2C" />
                        <Ellipse Canvas.Left="37" Canvas.Top="3" Width="8" Height="8" Fill="#3A2E2C" />
                        <Ellipse Canvas.Left="6" Canvas.Top="11" Width="40" Height="33" Fill="#6C6459" />
                        <Polygon Points="13,20 24,23 13,24" Fill="#1B1512" />
                        <Polygon Points="39,20 28,23 39,24" Fill="#1B1512" />
                        <Polygon Points="14,24 23,25 14,27" Fill="#C4342B" />
                        <Polygon Points="38,24 29,25 38,27" Fill="#C4342B" />
                        <Ellipse Canvas.Left="23" Canvas.Top="27" Width="6" Height="5" Fill="#241F1B" />
                        <Path Data="M 16,34 Q 26,40 36,34" Stroke="#1B1512" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Polygon Points="19,35 21,35 20,39" Fill="#F4F1EC" />
                        <Polygon Points="31,35 33,35 32,39" Fill="#F4F1EC" />
                    </Canvas>

                    <Canvas x:Name="MousePeekBottomRight" Width="48" Height="42" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-14,-18" Opacity="0" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><ScaleTransform x:Name="MousePeekBottomRightScale" ScaleX="0.6" ScaleY="0.6" /></Canvas.RenderTransform>
                        <Ellipse Canvas.Left="3" Canvas.Top="0" Width="16" Height="16" Fill="#5B5650" />
                        <Ellipse Canvas.Left="33" Canvas.Top="0" Width="16" Height="16" Fill="#5B5650" />
                        <Ellipse Canvas.Left="7" Canvas.Top="3" Width="8" Height="8" Fill="#3A2E2C" />
                        <Ellipse Canvas.Left="37" Canvas.Top="3" Width="8" Height="8" Fill="#3A2E2C" />
                        <Ellipse Canvas.Left="6" Canvas.Top="11" Width="40" Height="33" Fill="#6C6459" />
                        <Polygon Points="13,20 24,23 13,24" Fill="#1B1512" />
                        <Polygon Points="39,20 28,23 39,24" Fill="#1B1512" />
                        <Polygon Points="14,24 23,25 14,27" Fill="#C4342B" />
                        <Polygon Points="38,24 29,25 38,27" Fill="#C4342B" />
                        <Ellipse Canvas.Left="23" Canvas.Top="27" Width="6" Height="5" Fill="#241F1B" />
                        <Path Data="M 16,34 Q 26,40 36,34" Stroke="#1B1512" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Polygon Points="19,35 21,35 20,39" Fill="#F4F1EC" />
                        <Polygon Points="31,35 33,35 32,39" Fill="#F4F1EC" />
                    </Canvas>
                </Grid>
                <TextBlock Grid.Row="3" Margin="0,16,0,12" TextWrapping="Wrap" Foreground="#69788B" Text="No se conecta a Internet, no guarda datos, no se inicia con Windows y no requiere permisos de administrador." />
                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="StartStopButton" Width="125" Height="34" Margin="0,0,10,0" Click="StartStopButton_Click" Content="Iniciar" />
                    <Button x:Name="StopNowButton" Width="125" Height="34" IsEnabled="False" Click="StopNowButton_Click" Content="Detener ahora" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
